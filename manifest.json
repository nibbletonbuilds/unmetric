{
    "manifest_version": 3,
    "name": "CF Rating Scrubber",
    "version": "1.0",
    "description": "Hide all Codeforces ratings, colors, and titles.",
    "permissions": [],
    "web_accessible_resources": [
        {
            "resources": ["hide.css"],
            "matches": ["*://codeforces.com/*", "*://*.codeforces.com/*"]
        }
    ],
    "content_scripts": [
        {
            "matches": ["*://codeforces.com/*", "*://*.codeforces.com/*"],
            "js": ["content.js"],
            "css": ["hide.css"]
        }
    ]
}